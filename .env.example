# ─────────────────────────────────────────────────────────────────────────────
# birdie-platform — environment template
#
# You do NOT need any of this to run the demo. With no .env at all the whole
# platform runs in mock mode: fake data, mock API transport, no logins.
# Copy to .env.local (apps/web) or .env (packages/connectors, portal-bot)
# only when you want to connect real services.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. Anything other than "false" keeps mock mode on.
BIRDIE_MOCK=true

# ── Web app ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TENANT_SLUG=demo
# Optional access code for the demo (empty = open demo)
DEMO_ACCESS_CODE=
# Legacy gate password for non-demo routes when BIRDIE_MOCK=false
BIRDIE_ACCESS_PASSWORD=

# Supabase (Postgres + auth)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Service-to-service secrets (generate with: openssl rand -hex 32)
SYNC_SECRET=change-me
CRON_SECRET=change-me
BIRDIE_BOT_TOKEN=change-me

# AI document filling / e-mail triage
ANTHROPIC_API_KEY=your-anthropic-api-key

# Installer profile printed on utility forms and e-mails
INSTALLER_COMPANY="SunPeak Solar GmbH"
INSTALLER_CONTACT="Jane Doe"
INSTALLER_ADDRESS="Musterstraße 1"
INSTALLER_PLZ=10115
INSTALLER_CITY=Berlin
INSTALLER_PLZORT="10115 Berlin"
INSTALLER_PHONE="+49 30 0000000"
INSTALLER_EMAIL=office@sunpeak-solar.example
INSTALLER_AUSWEIS=
INSTALLER_NB_REG=

# CRM workflow board — workspace-specific column ids
CRM_COLUMN_UTILITY_REQUEST=
CRM_COLUMN_COMMISSIONING=

# Optional marketing scripts (off when empty)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_APOLLO_TRACKER_ID=
NEXT_PUBLIC_APOLLO_INBOUND_ID=

# ── Connectors ───────────────────────────────────────────────────────────────
REONIC_API_KEY=your-reonic-api-key
REONIC_CLIENT_ID=your-reonic-client-id
REONIC_BASE_URL=https://api.reonic.de/rest/v2
SEVDESK_API_KEY=your-sevdesk-api-token
BREVO_API_KEY=your-brevo-api-key
ECOFLOW_ACCESS_KEY=your-ecoflow-access-key
ECOFLOW_SECRET_KEY=your-ecoflow-secret-key
ECOFLOW_HOST=api-e.ecoflow.com
TIBBER_TOKEN=your-tibber-token
SOLCAST_API_KEY=your-solcast-api-key
SOLCAST_RESOURCE_ID=your-solcast-site-id
OWM_API_KEY=your-openweathermap-key
OWM_LAT=52.52
OWM_LON=13.40
AWATTAR_REGION=de
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_FOLDER_ID=
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
PCLOUD_ACCESS_TOKEN=your-pcloud-token
PCLOUD_FOLDER_REGISTRATIONS=
PCLOUD_FOLDER_SUBMISSIONS=
VDE_E2_TEMPLATE_ID=
VDE_E3_TEMPLATE_ID=

# ── Portal bot (automations/portal-bot) ──────────────────────────────────────
BIRDIE_API_URL=http://localhost:3000
NETZBOT_API_URL=http://localhost:3099
NETZBOT_HEADLESS=true
NETZBOT_POLL_MS=60000
# One entry per utility portal: NETZBOT_CREDS_<SLUG>="user|password|portalUrl"
# NETZBOT_CREDS_SW_SUHL="installer@example.com|change-me|https://portal.utility.example"
